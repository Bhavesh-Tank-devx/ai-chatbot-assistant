<script>
  (function() {
    // ----------------------------------------------------
    // Element Selectors
    // ----------------------------------------------------
    const triggerBtn = document.getElementById('cx-trigger');
    const widgetPanel = document.getElementById('cx-widget');
    const closeBtn = document.getElementById('cx-close');
    const messagesContainer = document.getElementById('cx-messages');
    const form = document.getElementById('cx-form');
    const input = document.getElementById('cx-input');
    const sendBtn = document.getElementById('cx-send');
    const typingIndicator = document.getElementById('cx-typing');
    const initialQuickReplies = document.getElementById('cx-initial-quick-replies');
    
    // ----------------------------------------------------
    // Widget Toggle Logic
    // ----------------------------------------------------
    function toggleWidget() {
      const isClosed = widgetPanel.classList.contains('cx-closed');
      if (isClosed) {
        // Open
        widgetPanel.classList.remove('cx-closed');
        triggerBtn.classList.add('cx-active');
        setTimeout(() => input.focus(), 300); // Focus input after animation
      } else {
        // Close
        widgetPanel.classList.add('cx-closed');
        triggerBtn.classList.remove('cx-active');
      }
    }

    triggerBtn.addEventListener('click', toggleWidget);
    closeBtn.addEventListener('click', toggleWidget);

    // Input behavior
    input.addEventListener('input', () => {
      sendBtn.disabled = input.value.trim() === '';
    });

    // ----------------------------------------------------
    // Chat Logic & WebSocket
    // ----------------------------------------------------
    let sessionId = sessionStorage.getItem('cx_session_id');
    if (!sessionId) {
      sessionId = 'sess_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
      sessionStorage.setItem('cx_session_id', sessionId);
    }
    let userId = 'anonymous_user';

    // Must match local Gateway server
    const WS_URL = 'wss://redressable-spectrochemical-aarav.ngrok-free.dev/ws';
    let ws = null;
    let currentBotMessageBubble = null;

    function connectWebSocket() {
      if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) {
        return;
      }
      ws = new WebSocket(WS_URL);
      
      ws.onopen = () => {
        console.log('[ChatX] Connected to Server');
      };

      ws.onmessage = (event) => {
        try {
          const data = JSON.parse(event.data);
          console.log('[ChatX WS Received]:', data);
          
          if (data.type === 'bot_text_delta') {
            hideTyping();
            if (!currentBotMessageBubble) {
               currentBotMessageBubble = createBotMessageRow();
            }
            appendMarkdown(currentBotMessageBubble, data.payload.delta);
            scrollToBottom();
          }

          if (data.type === 'bot_quick_replies' && data.payload.options) {
            hideTyping();
            appendQuickReplies(data.payload.options);
            scrollToBottom();
          }

          if (data.type === 'bot_cards' && data.payload.cards && data.payload.cards.length > 0) {
            hideTyping();
            appendProductCarousel(data.payload.cards);
            scrollToBottom();
          }

          if (data.type === 'bot_done') {
            currentBotMessageBubble = null;
            // E.g., render quick replies here if provided in the future data payloads
          }

          if (data.type === 'bot_error') {
             hideTyping();
             appendErrorMessage(data.payload.message || 'An error occurred.');
             currentBotMessageBubble = null;
             scrollToBottom();
          }

        } catch (err) {
          console.error('[ChatX] Error parsing msg:', err);
        }
      };

      ws.onclose = () => {
        setTimeout(connectWebSocket, 3000);
      };
    }

    connectWebSocket();

    // ----------------------------------------------------
    // UI Render Helpers
    // ----------------------------------------------------
    function showTyping() {
      typingIndicator.classList.remove('cx-hidden');
      scrollToBottom();
    }

    function hideTyping() {
      typingIndicator.classList.add('cx-hidden');
    }

    function scrollToBottom() {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function createUserMessageRow(text) {
      const row = document.createElement('div');
      row.className = 'cx-msg-row cx-msg-user';
      row.innerHTML = `<div class="cx-bubble"><p>${escapeHTML(text)}</p></div>`;
      messagesContainer.appendChild(row);
      return row;
    }

    // Bot SVG avatar string
    const botAvatarSVG = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path></svg>`;

    function createBotMessageRow() {
      const row = document.createElement('div');
      row.className = 'cx-msg-row cx-msg-bot';
      
      const avatar = document.createElement('div');
      avatar.className = 'cx-msg-avatar';
      avatar.innerHTML = botAvatarSVG;
      
      const bubble = document.createElement('div');
      bubble.className = 'cx-bubble';
      bubble.innerHTML = '<p></p>'; // target for text
      
      row.appendChild(avatar);
      row.appendChild(bubble);
      
      messagesContainer.appendChild(row);
      return bubble.querySelector('p'); // return paragraph to append text
    }

    function appendErrorMessage(text) {
      const p = createBotMessageRow();
      p.parentElement.style.background = '#fee2e2'; // Light red
      p.parentElement.style.color = '#991b1b'; // Dark red
      p.textContent = text;
    }

    function appendMarkdown(element, textChunk) {
      // Basic rendering: replace standard newlines with <br>
      // For streaming text, we simply append the text. In a prod setup, use a real markdown parser.
      // We avoid aggressive escaping chunk-by-chunk because it can truncate midway through an entity.
      const parsedText = textChunk.replace(/\n/g, '<br/>');
      element.innerHTML += parsedText;
    }

    function appendQuickReplies(options) {
      if (!options || !options.length) return;
      
      const container = document.createElement('div');
      container.className = 'cx-quick-replies';
      container.style.animation = 'cx-slide-up 0.5s ease forwards';
      
      options.forEach(opt => {
        // opt might be a string or an object with a label property
        const text = typeof opt === 'string' ? opt : (opt.title || opt.label || opt.value || JSON.stringify(opt));
        const btn = document.createElement('button');
        btn.className = 'cx-chip';
        btn.innerText = text;
        btn.addEventListener('click', () => {
          container.style.display = 'none'; // hide initials
          sendMessage(text);
        });
        container.appendChild(btn);
      });
      
      messagesContainer.appendChild(container);
    }

    function appendProductCarousel(cards) {
      console.log('[ChatX] appendProductCarousel called with:', cards);
      const carousel = document.createElement('div');
      carousel.className = 'cx-carousel';
      carousel.style.animation = 'cx-slide-up 0.5s ease forwards';
      
      let html = '';
      cards.forEach((card, i) => {
        console.log(`[ChatX] Processing card ${i}:`, card);
        // Fallback checks tailored to the BotCard typescript interface + previous version checks
        const link = card.product_url ? card.product_url : (card.handle ? `/products/${card.handle}` : '#');
        const imgUrl = card.image_url || card.imageUrl || '';
        
        // Ensure price handles 0 correctly
        let priceStr = '';
        if (card.variants && card.variants.length > 0 && card.variants[0].price !== undefined) {
           priceStr = `$${card.variants[0].price}`;
        } else if (card.price !== undefined) {
           priceStr = card.currency ? `${card.currency} ${card.price}` : `$${card.price}`;
        }

        let tagsHtml = '';
        if (card.badges && Array.isArray(card.badges)) {
           card.badges.forEach(b => tagsHtml += `<span class="cx-badge">${b}</span>`);
        } else {
           // Fallbacks
           if (card.productType) tagsHtml += `<span class="cx-badge">${card.productType}</span>`;
           if (card.color) tagsHtml += `<span class="cx-badge">${card.color}</span>`;
           if (card.tags && Array.isArray(card.tags)) card.tags.forEach(t => tagsHtml += `<span class="cx-badge">${t}</span>`);
        }
        
        if (card.is_stretch_budget) {
           tagsHtml += `<span class="cx-badge" style="background:#fef08a;color:#854d0e;">Over Budget</span>`;
        }

        const title = card.title || 'Recommended Item';

        html += `
          <a href="${link}" target="_blank" class="cx-card">
            <img class="cx-card-img" src="${imgUrl}" alt="${title}" loading="lazy" onerror="this.src='https://cdn.shopify.com/s/images/admin/no-image-large.gif';" />
            <div class="cx-card-body">
              <h3 class="cx-card-title">${title}</h3>
              <div class="cx-card-price">${priceStr}</div>
              <div class="cx-card-badges">${tagsHtml}</div>
            </div>
          </a>
        `;
      });
      
      console.log('[ChatX] Generated HTML string for carousel:', html);
      carousel.innerHTML = html;
      messagesContainer.appendChild(carousel);
      scrollToBottom();
    }

    // Quick Replies Binding
    document.querySelectorAll('.cx-chip').forEach(chip => {
      chip.addEventListener('click', function() {
        if (initialQuickReplies) initialQuickReplies.style.display = 'none'; // hide initials
        sendMessage(this.innerText);
      });
    });

    // ----------------------------------------------------
    // Sending Messages
    // ----------------------------------------------------
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const message = input.value.trim();
      if (!message) return;
      
      if (initialQuickReplies) initialQuickReplies.style.display = 'none';
      sendMessage(message);
      
      input.value = '';
      sendBtn.disabled = true;
    });

    function sendMessage(text) {
      createUserMessageRow(text);
      scrollToBottom();
      showTyping();

      if (ws && ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({
          type: 'user_message',
          session_id: sessionId,
          user_id: userId,
          route: 'BEDROCK',
          text: text
        }));
      } else {
        hideTyping();
        appendErrorMessage('Not connected to server. Attempting to reconnect...');
        connectWebSocket();
      }
    }

    // Utilities
    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#39;',
            '"': '&quot;'
          }[tag] || tag)
      );
    }

  })();
</script>

