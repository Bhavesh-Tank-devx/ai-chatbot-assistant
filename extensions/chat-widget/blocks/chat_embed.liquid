<div id="cx-app" style="--cx-brand: #6b21a8; --cx-brand-light: #f3e8ff; --cx-brand-hover: #581c87; --cx-bg: #ffffff; --cx-text: #1a1a1a; --cx-text-muted: #6b7280; --cx-gray-bg: #f3f4f6; --cx-border: #e5e7eb;">
  
  <!-- Trigger Button -->
