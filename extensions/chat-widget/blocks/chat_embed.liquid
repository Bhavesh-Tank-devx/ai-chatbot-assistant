  }

  /* Product Carousel */
  .cx-carousel {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden; /* Hide vertical overflow rather than being visible, prevents weird vertical shifts */
    gap: 12px;
    /* Add padding to account for box shadows (assuming max 10px shadow) */
    padding: 12px 12px 16px 12px; 
    margin-top: 8px;
    margin-left: 20px; /* Align closer to the message to make room for padding */
    margin-right: -24px; /* Allow scrolling all the way to the right edge of widget */
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    min-height: 350px; /* Base height + padding */
